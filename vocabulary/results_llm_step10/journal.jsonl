{"case": "ablation_t1_no_easter_holidays", "step": "all rows / payment method == 'LS' / proposals for collection", "note": "kept: exact rows (search, held out) (12143, 2829) -> (12183, 2845)", "time": "11:57:07", "tried": [], "accepted": ["proposed: brick 1 (answer 1) (extends: next business day (Ticino, fixed only))"], "proposals": {"proposed: brick 1 (answer 1) (extends: next business day (Ticino, fixed only))": "def brick(d):\n    # next business day (Ticino, fixed + Easter-derived movable holidays)\n    def _easter_sunday(year):\n        a = year % 19\n        b = year // 100\n        c = year % 100\n        dd = b // 4\n        e = b % 4\n        f = (b + 8) // 25\n        g = (b - f + 1) // 3\n        h = (19 * a + b - dd - g + 15) % 30\n        i = c // 4\n        k = c % 4\n        l = (32 + 2 * e + 2 * i - h - k) % 7\n        m = (a + 11 * h + 22 * l) // 451\n        month = (h + l - 7 * m + 114) // 31\n        day = ((h + l - 7 * m + 114) % 31) + 1\n        return dt.date(year, month, day)\n\n    def _movable(year):\n        es = _easter_sunday(year)\n        return {\n            es + dt.timedelta(days=1),    # Easter Monday\n            es + dt.timedelta(days=39),   # Ascension\n            es + dt.timedelta(days=50),   # Whit Monday\n            es + dt.timedelta(days=60),   # Corpus Christi\n        }\n\n    holidays = set()\n    for y in (d.year - 1, d.year, d.year + 1):\n        holidays |= _movable(y)\n\n    result = best(d)\n    while result in holidays:\n        result = best(result + dt.timedelta(days=1))\n    return result\n", "proposed: next business day (Ticino, fixed + Easter-dependent movable holidays) (answer 2) (extends: next business day (Ticino, fixed only))": "# name: next business day (Ticino, fixed + Easter-dependent movable holidays)\n\ndef _easter(year):\n    \"\"\"Meeus/Jones/Butcher algorithm \u2013 returns Easter Sunday as a date.\"\"\"\n    a = year % 19\n    b = year // 100\n    c = year % 100\n    d = b // 4\n    e = b % 4\n    f = (b + 8) // 25\n    g = (b - f + 1) // 3\n    h = (19 * a + b - d - g + 15) % 30\n    i = c // 4\n    k = c % 4\n    l = (32 + 2 * e + 2 * i - h - k) % 7\n    m = (a + 11 * h + 22 * l) // 451\n    month = (h + l - 7 * m + 114) // 31\n    day = ((h + l - 7 * m + 114) % 31) + 1\n    return dt.date(year, month, day)\n\n_EASTER_OFFSETS = (1, 39, 50, 60)  # Easter Mon, Ascension, Pentecost Mon, Corpus Christi\n\ndef _is_movable_holiday(d):\n    easter = _easter(d.year)\n    return any(d == easter + dt.timedelta(days=off) for off in _EASTER_OFFSETS)\n\ndef brick(d):\n    result = best(d)\n    while _is_movable_holiday(result):\n        result = best(result + dt.timedelta(days=1))\n    return result\n"}}
