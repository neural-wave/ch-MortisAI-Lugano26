{
  "name": "ablation_t0_no_rates_no_premium_type",
  "description": "Ablation: t0 without the rate table and without the premium type column. The product code is a proxy (FLSP is the single-premium product), so the engine may recover the rates through it.",
  "target": {
    "file": "t0_commission",
    "keys": [
      "policy_id",
      "due_nr"
    ],
    "value": "amount",
    "type": "decimal"
  },
  "nrexcp": "t0_commission",
  "sample": 30,
  "depth": 3,
  "rows": {
    "from": "NRPREM",
    "where": "PR_STATE == 'P'",
    "key": [
      "PR_POLNR",
      "int(PR_DUENR)"
    ],
    "join": [
      {
        "table": "NRRISK",
        "on": {
          "RK_POLNR": "PR_POLNR"
        },
        "where": "RK_RSKNR == '1'"
      },
      {
        "table": "NRPOLH",
        "on": {
          "PH_POLNR": "PR_POLNR"
        },
        "as_of": "date(PR_RCVDT)"
      },
      {
        "table": "NRBROK",
        "on": {
          "BR_BRKNR": "PH_BRKNR"
        }
      }
    ]
  },
  "holes": {
    "rate": {
      "fit": "ratio",
      "of": "num(PR_AMTRC, 2)"
    },
    "rounding": "ROUNDINGS"
  },
  "formula": "rounding(num(PR_AMTRC, 2) * rate, date(PR_RCVDT))",
  "features": {
    "broker tier": "BR_TIER",
    "product": "PH_PRDCD"
  }
}