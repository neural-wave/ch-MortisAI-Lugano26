{
  "name": "ablation_t0_no_rates_no_tier",
  "description": "Ablation: t0 without the rate table NRCOMR and without the broker tier (NRBROK is not read). The tier is a property of the broker that no read column carries: the broker number determines it, but through 400 brokers that a tree of three tests cannot map. The engine should NOT reach 100 %: it must report what it cannot explain instead of inventing a rule.",
  "target": {
    "file": "t0_commission",
    "keys": [
      "policy_id",
      "due_nr"
    ],
    "value": "amount",
    "type": "decimal"
  },
  "nrexcp": "t0_commission",
  "sample": 30,
  "depth": 3,
  "rows": {
    "from": "NRPREM",
    "where": "PR_STATE == 'P'",
    "key": [
      "PR_POLNR",
      "int(PR_DUENR)"
    ],
    "join": [
      {
        "table": "NRRISK",
        "on": {
          "RK_POLNR": "PR_POLNR"
        },
        "where": "RK_RSKNR == '1'"
      },
      {
        "table": "NRPOLH",
        "on": {
          "PH_POLNR": "PR_POLNR"
        },
        "as_of": "date(PR_RCVDT)"
      }
    ]
  },
  "holes": {
    "rate": {
      "fit": "ratio",
      "of": "num(PR_AMTRC, 2)"
    },
    "rounding": "ROUNDINGS"
  },
  "formula": "rounding(num(PR_AMTRC, 2) * rate, date(PR_RCVDT))",
  "features": {
    "premium type": "RK_TARKEY[5]",
    "product": "PH_PRDCD",
    "broker": "PH_BRKNR"
  }
}
